version: '3.8'

services:
  db:
    image: mariadb:10.11
    container_name: sba301-db
    restart: always
    environment:
      MYSQL_ROOT_PASSWORD: "{{ db_root_password }}"
      MYSQL_DATABASE: "{{ db_name }}"
      MYSQL_USER: "{{ db_user }}"
      MYSQL_PASSWORD: "{{ db_password }}"
    volumes:
      - db_data:/var/lib/mysql
    ports:
      - "127.0.0.1:3306:3306" # Chỉ bind ở localhost để tránh expose ra ngoài internet

  app:
    build:
      context: .
      dockerfile: Dockerfile
    container_name: sba301-app
    restart: always
    depends_on:
      - db
    ports:
      - "127.0.0.1:8080:8080" # Chỉ bind localhost, Nginx sẽ làm reverse proxy
    environment:
      - SPRING_DATASOURCE_URL=jdbc:mariadb://db:3306/{{ db_name }}
      - SPRING_DATASOURCE_USERNAME={{ db_user }}
      - SPRING_DATASOURCE_PASSWORD={{ db_password }}
      - SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.mariadb.jdbc.Driver
      - SPRING_JPA_PROPERTIES_HIBERNATE_DIALECT=org.hibernate.dialect.MariaDBDialect
      - SPRING_JPA_HIBERNATE_DDL_AUTO=update
      - APP_JWT_SECRET={{ jwt_secret }}
      - SPRING_MAIL_USERNAME={{ smtp_username }}
      - SPRING_MAIL_PASSWORD={{ smtp_password }}
      - VNPAY_TMN_CODE={{ vnpay_tmn_code }}
      - VNPAY_HASH_SECRET={{ vnpay_hash_secret }}
      - VNPAY_RETURN_URL=https://{{ domain_frontend }}/checkout/vnpay-return
      - APP_CORS_ALLOWED_ORIGINS=https://{{ domain_frontend }}

volumes:
  db_data:
